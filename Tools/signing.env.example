# Copy to Tools/signing.env (which is gitignored) and fill in your own values.
#
#   cp Tools/signing.env.example Tools/signing.env
#
# Both are also readable from the environment, so CI can set them instead.

# Your Apple Developer Team ID — Xcode ▸ Settings ▸ Accounts, or
# developer.apple.com ▸ Membership. Not secret; it is embedded in every
# signed app you ship.
MULTIPING_TEAM_ID=""

# The Apple ID used to create the notarization keychain profile.
MULTIPING_APPLE_ID=""

# Name of the keychain profile holding your notarization credentials, created by
#   xcrun notarytool store-credentials "<name>" \
#     --apple-id "$MULTIPING_APPLE_ID" --team-id "$MULTIPING_TEAM_ID"
# The app-specific password it prompts for is stored in your keychain and is
# never read by, or written into, this repository.
MULTIPING_NOTARY_PROFILE="MultiPing-Notary"
